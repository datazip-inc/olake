{
    "type": "object",
    "properties": {
        "authdb": {
            "type": "string",
            "title": "Auth DB",
            "description": "Authentication database (mostly admin)",
            "default": "admin"
        },
        "auth_mechanism": {
            "type": "string",
            "title": "Authentication Mechanism",
            "description": "MongoDB authentication mechanism. Leave empty to use the driver's default SCRAM negotiation (modern servers prefer SCRAM-SHA-256). Set SCRAM-SHA-1 or SCRAM-SHA-256 only when an explicit mechanism is required. Use PLAIN for LDAP (TLS required), MONGODB-X509 for certificate auth (TLS and client certificate required; username optional), or MONGODB-OIDC for OpenID Connect (password-less; pass ENVIRONMENT and TOKEN_RESOURCE via Additional Connection Parameters for Azure/GCP URI flows). For MONGODB-AWS authentication, use the 'IAM Authentication' toggle instead. GSSAPI (Kerberos) is not currently supported due to low market adoption.",
            "enum": [
                "",
                "SCRAM-SHA-1",
                "SCRAM-SHA-256",
                "PLAIN",
                "MONGODB-X509",
                "MONGODB-OIDC"
            ],
            "default": ""
        },
        "backoff_retry_count": {
            "type": "integer",
            "title": "Retry Count",
            "description": "Number of sync retry attempts using exponential backoff",
            "default": 3
        },
        "chunking_strategy": {
            "type": "string",
            "title": "Chunking Strategy",
            "description": "Chunking strategy (timestamp, uses Split Vector strategy if the field is left empty)",
            "default": "Split Vector",
            "enum": [
                "Split Vector",
                "Timestamp"
            ]
        },
        "database": {
            "type": "string",
            "title": "Database Name",
            "description": "Name of the mongodb database selected for replication"
        },
        "hosts": {
            "type": "array",
            "title": "Hosts",
            "description": "Specifies the hostnames or IP addresses of MongoDB for connection",
            "items": {
                "type": "string"
            },
            "minItems": 1
        },
        "max_threads": {
            "type": "integer",
            "title": "Max Threads",
            "description": "Max parallel threads for chunk snapshotting",
            "default": 3
        },
        "password": {
            "type": "string",
            "title": "Password",
            "description": "Password with the username for authentication",
            "format": "password"
        },
        "read_preference": {
            "type": "string",
            "title": "Read Preference",
            "description": "Read preference for MongoDB (e.g., secondaryPreferred)"
        },
        "replica_set": {
            "type": "string",
            "title": "Replica Set",
            "description": "MongoDB replica set name (if applicable)"
        },
        "srv": {
            "type": "boolean",
            "title": "Use SRV",
            "description": "Enable this option if using DNS SRV connection strings. When set to true, the hosts field must contain only one entry - a DNS SRV address (['mongodataset.pigiy.mongodb.net'])",
            "default": false
        },
        "username": {
            "type": "string",
            "title": "Username",
            "description": "Username for MongoDB authentication"
        },
        "use_iam": {
            "type": "boolean",
            "title": "IAM Authentication",
            "description": "Enable this option to use IAM-based authentication instead of username and password",
            "default": false
        },
        "ssl": {
            "type": "object",
            "description": "SSL/TLS configuration for secure database connections",
            "properties": {
                "mode": {
                    "type": "string",
                    "title": "SSL Configuration",
                    "enum": [
                        "disable",
                        "require",
                        "verify-ca",
                        "verify-full"
                    ],
                    "default": "disable"
                }
            },
            "required": [],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "verify-ca"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "server_ca": {
                                "type": "string",
                                "title": "Server CA Certificate",
                                "description": "CA certificate content (PEM format) for server verification"
                            },
                            "client_cert": {
                                "type": "string",
                                "title": "Client Certificate",
                                "description": "Client certificate content (PEM format) for mutual TLS authentication"
                            },
                            "client_key": {
                                "type": "string",
                                "title": "Client Key",
                                "description": "Client private key content (PEM format) for mutual TLS authentication"
                            }
                        },
                        "required": [
                            "server_ca"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "verify-full"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "server_ca": {
                                "type": "string",
                                "title": "Server CA Certificate",
                                "description": "CA certificate content (PEM format) for server verification"
                            },
                            "client_cert": {
                                "type": "string",
                                "title": "Client Certificate",
                                "description": "Client certificate content (PEM format) for mutual TLS authentication"
                            },
                            "client_key": {
                                "type": "string",
                                "title": "Client Key",
                                "description": "Client private key content (PEM format) for mutual TLS authentication"
                            }
                        },
                        "required": [
                            "server_ca"
                        ]
                    }
                }
            ]
        },
        "additional_params": {
            "type": "object",
            "title": "Additional Connection Parameters",
            "description": "Additional MongoDB connection string parameters (e.g., tls, connectTimeout). Each parameter will be added to the connection URI.",
            "additionalProperties": true
        },
        "ssh_config": {
            "title": "SSH Config",
            "description": "OLake uses SSH to connect to the database.",
            "oneOf": [
                {
                    "type": "object",
                    "title": "No Tunnel",
                    "properties": {
                        "type": {
                            "const": "no_tunnel"
                        }
                    },
                    "required": ["type"]
                },
                {
                    "type": "object",
                    "title": "SSH Key Authentication",
                    "properties": {
                        "type": {
                            "const": "ssh_key_authentication"
                        },
                        "host": {
                            "type": "string",
                            "title": "SSH Host",
                            "description": "SSH host address"
                        },
                        "port": {
                            "type": "integer",
                            "title": "SSH Port",
                            "description": "Port number to connect to the SSH server"
                        },
                        "username": {
                            "type": "string",
                            "title": "SSH Username",
                            "description": "Username to authenticate with the SSH server"
                        },
                        "private_key": {
                            "type": "string",
                            "title": "SSH Private Key",
                            "description": "SSH private key to authenticate with the SSH server"
                        },
                        "passphrase": {
                            "type": "string",
                            "title": "SSH Passphrase",
                            "description": "Passphrase to decrypt the encrypted SSH private key",
                            "format": "password"
                        }
                    },
                    "required": [
                        "host",
                        "port",
                        "username",
                        "private_key",
                        "type"
                    ]
                },
                {
                    "type": "object",
                    "title": "SSH Password Authentication",
                    "properties": {
                        "type": {
                            "const": "ssh_password_authentication"
                        },
                        "host": {
                            "type": "string",
                            "title": "SSH Host",
                            "description": "SSH host address"
                        },
                        "port": {
                            "type": "integer",
                            "title": "SSH Port",
                            "description": "Port number to connect to the SSH server"
                        },
                        "username": {
                            "type": "string",
                            "title": "SSH Username",
                            "description": "Username to authenticate with the SSH server"
                        },
                        "password": {
                            "type": "string",
                            "title": "SSH Password",
                            "description": "Password to authenticate with the SSH server",
                            "format": "password",
                            "minLength": 1
                        }
                    },
                    "required": [
                        "host",
                        "port",
                        "username",
                        "password",
                        "type"
                    ]
                }
            ]
        }
    },
    "required": [
        "hosts",
        "database"
    ],
    "allOf": [
        {
            "if": {
                "properties": {
                    "use_iam": {
                        "const": true
                    }
                },
                "required": [
                    "use_iam"
                ]
            },
            "then": {},
            "else": {
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "auth_mechanism": {
                                    "enum": [
                                        "PLAIN",
                                        "MONGODB-X509",
                                        "MONGODB-OIDC"
                                    ]
                                }
                            },
                            "required": [
                                "auth_mechanism"
                            ]
                        },
                        "then": {},
                        "else": {
                            "required": [
                                "authdb",
                                "username",
                                "password"
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "auth_mechanism": {
                                    "const": "PLAIN"
                                }
                            },
                            "required": [
                                "auth_mechanism"
                            ]
                        },
                        "then": {
                            "required": [
                                "username",
                                "password"
                            ]
                        }
                    }
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "auth_mechanism": {
                        "const": "PLAIN"
                    }
                },
                "required": [
                    "auth_mechanism"
                ]
            },
            "then": {
                "properties": {
                    "ssl": {
                        "properties": {
                            "mode": {
                                "enum": [
                                    "require",
                                    "verify-ca",
                                    "verify-full"
                                ]
                            }
                        },
                        "required": [
                            "mode"
                        ]
                    }
                },
                "required": [
                    "ssl"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "auth_mechanism": {
                        "const": "MONGODB-X509"
                    }
                },
                "required": [
                    "auth_mechanism"
                ]
            },
            "then": {
                "properties": {
                    "password": {
                        "maxLength": 0
                    },
                    "ssl": {
                        "properties": {
                            "mode": {
                                "enum": [
                                    "require",
                                    "verify-ca",
                                    "verify-full"
                                ]
                            },
                            "client_cert": {
                                "type": "string",
                                "title": "Client Certificate",
                                "description": "Client certificate content (PEM format) for mutual TLS authentication",
                                "minLength": 1
                            },
                            "client_key": {
                                "type": "string",
                                "title": "Client Key",
                                "description": "Client private key content (PEM format) for mutual TLS authentication",
                                "minLength": 1
                            }
                        },
                        "required": [
                            "mode",
                            "client_cert",
                            "client_key"
                        ]
                    }
                },
                "required": [
                    "ssl"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "auth_mechanism": {
                        "const": "MONGODB-OIDC"
                    }
                },
                "required": [
                    "auth_mechanism"
                ]
            },
            "then": {
                "properties": {
                    "password": {
                        "maxLength": 0
                    },
                    "additional_params": {
                        "properties": {
                            "authMechanismProperties": {
                                "type": "string",
                                "title": "OIDC Mechanism Properties",
                                "description": "Use ENVIRONMENT:azure or ENVIRONMENT:gcp with TOKEN_RESOURCE",
                                "minLength": 1
                            }
                        },
                        "required": [
                            "authMechanismProperties"
                        ]
                    }
                },
                "required": [
                    "additional_params"
                ]
            }
        }
    ]
}
