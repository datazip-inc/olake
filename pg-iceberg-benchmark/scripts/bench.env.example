# Copy to bench.env and fill in. bench.env and .pgpass_bench are git-ignored.
# --- source Postgres (needs wal_level=logical and a user with replication rights) ---
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGSSLMODE=require
# --- destination: Iceberg on AWS Glue. Credentials come from the host's instance role. ---
AWS_REGION=ap-south-1
WAREHOUSE=s3://your-bucket
GLUE_DB=bench_run1
# --- source objects. BASE_TABLE must already exist; the rest are created by sql/01_create_source.sql ---
# Pipelines assume the TPC-H customer schema (c_custkey ... c_comment).
BASE_TABLE=tpch.customer
SRC_TABLE=bench_customer_run1
SMOKE_TABLE=bench_smoke_run1
PUBLICATION=bench_pub_run1
